---
/**
 * Botão da marca. Variantes vindas do Figma:
 * - `primary`  — sólido vermelho com o canto "folha" (padrão da página)
 * - `outline`  — pílula com contorno vermelho ("Central de Ajuda")
 * - `pill`     — pílula branca sobre fundo escuro (CTA do hero)
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'pill';
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', class: className = '', ...rest } = Astro.props;

const variantes = {
  primary: 'btn btn-primary',
  outline: 'btn btn-outline',
  pill: 'btn btn-pill-light',
} as const;

const Tag = href ? 'a' : 'button';

/**
 * Link para fora do site abre em nova aba — regra única aqui em vez de repetir
 * target/rel em cada CTA. Âncoras (#faq) seguem na mesma aba. Dá para
 * sobrescrever passando `target` explícito.
 */
const externo = href?.startsWith('http') ?? false;
const alvo = { ...(externo ? { target: '_blank', rel: 'noopener noreferrer' } : {}), ...rest };
---

<Tag href={href} class:list={[variantes[variant], className]} {...alvo}>
  <slot />
</Tag>
