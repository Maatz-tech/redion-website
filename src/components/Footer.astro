---
import Icon from './Icon.astro';
import { LEGAL_LINKS, SOCIAL_LINKS } from '../data/site';
---

<footer class="bg-dark-blue">
  <div
    class="flex flex-col items-center gap-10 px-6 py-10 lg:flex-row lg:items-start lg:justify-between lg:px-[120px] lg:py-20"
  >
    <!-- gap-3 no mobile: com gap-6 os dois logos + divisor davam 335 px numa
         faixa de 327 e o "eureca" era cortado na direita. -->
    <div class="flex w-full items-center justify-center gap-3 lg:w-auto lg:gap-6">
      <img
        src="/images/brand/redion-light.svg"
        alt="Redion"
        width="186"
        height="32"
        class="h-auto w-[45%] max-w-[148px] lg:w-[186px] lg:max-w-none"
      />
      <span class="h-9 w-px shrink-0 bg-on-dark-30 lg:h-[43px]" aria-hidden="true"></span>
      <img
        src="/images/brand/eureca-light.webp"
        alt="eureca"
        width="164"
        height="30"
        class="h-auto w-[45%] max-w-[147px] object-contain lg:w-[164px] lg:max-w-none"
      />
    </div>

    <ul class="flex items-center gap-3.5">
      {
        SOCIAL_LINKS.map((social) => (
          <li>
            <a
              href={social.href}
              class="social-link flex size-14 items-center justify-center rounded-full bg-white text-dark-blue"
              aria-label={social.label}
            >
              <Icon name="linkedin-mark" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="bg-light-gray px-6 py-6 lg:px-[120px]">
    <div
      class="flex flex-col items-center gap-4 lg:flex-row lg:justify-between lg:gap-0"
    >
      <ul class="flex items-center gap-4">
        {
          LEGAL_LINKS.map((link) => (
            <li>
              <a href={link.href} class="body-sm underline hover:text-bright-red">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="body-sm flex items-center gap-2">
        Desenvolvido por
        <img src="/images/brand/maatz.svg" alt="Maatz" width="72" height="18" />
      </p>
    </div>
  </div>
</footer>

<style>
  .social-link {
    transition:
      background-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .social-link:hover {
    background: var(--color-bright-red);
    color: #fff;
    transform: translateY(-3px);
  }
</style>
