---
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import RevealText from '../RevealText.astro';
import { REQUISITOS } from '../../data/conteudo';

/** "Requisitos" — node 4019:134 (desktop) / 4060:1611 (mobile). */

/** `**trecho**` vira <strong>; `|` separa em linhas. */
function linhas(texto: string) {
  return texto.split('|').map((linha) =>
    linha
      .split(/(\*\*[^*]+\*\*)/g)
      .filter(Boolean)
      .map((p) => ({ forte: p.startsWith('**'), texto: p.startsWith('**') ? p.slice(2, -2) : p }))
  );
}
---

<section id="requisitos" class="section-pad relative overflow-hidden bg-white">
  <!-- Curva vermelha discreta no canto inferior-esquerdo (node 4020:468) -->
  <img
    src={`${import.meta.env.BASE_URL}images/decor/curve-soft.svg`}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute bottom-[-2px] left-[-2px] hidden h-[260px] w-[607px] lg:block"
  />

  <div class="container-lp relative flex flex-col items-start gap-8 lg:items-center lg:gap-12">
    <div class="flex flex-col gap-4 lg:items-center lg:text-center">
      <p class="eyebrow" data-reveal>Requisitos</p>
      <RevealText as="h2" class="h2" text="O que você precisa para fazer parte" />
    </div>

    <ul
      class="flex w-full flex-col gap-4 lg:flex-row lg:flex-wrap lg:justify-center lg:gap-6"
      data-reveal-stagger
    >
      {
        REQUISITOS.map((req) => (
          <li class="card-soft flex items-center gap-5 p-5 lg:w-[384px] lg:flex-auto">
            <Icon name={req.icone} size={40} class="text-bright-red" />
            <div class="text-lg leading-[1.22] text-body">
              {linhas(req.texto).map((linha) => (
                <p>
                  {linha.map((p) =>
                    p.forte ? (
                      <strong class="font-semibold text-dark-blue">{p.texto}</strong>
                    ) : (
                      p.texto
                    )
                  )}
                </p>
              ))}
            </div>
          </li>
        ))
      }
    </ul>

    <div class="lg:self-center" data-reveal>
      <Button href="#o-programa">Conheça o Programa</Button>
    </div>
  </div>
</section>

<script>
  import { revealOnScroll, revealStagger, revealWords } from '../../lib/motion';

  revealWords('#requisitos [data-reveal-words]');
  revealOnScroll('#requisitos [data-reveal]');
  revealStagger('#requisitos [data-reveal-stagger]', 0.08);
</script>
