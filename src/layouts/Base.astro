---
import '../styles/global.css';
// Importada (em vez de referenciada em /public) para que o Vite gere a URL com
// hash e respeitando o `base` — necessário para o preview no GitHub Pages.
import gabaritoLatin from '../assets/fonts/gabarito-latin.woff2?url';

interface Props {
  title: string;
  description?: string;
  /**
   * Título/descrição do card de compartilhamento. Separados do title/description
   * de propósito: a busca e o card social têm públicos e limites diferentes — o
   * title do Google leva a marca e o gancho de conversão, o card do
   * WhatsApp/LinkedIn é mais curto e mais direto. Sem valor, caem no par de SEO.
   */
  ogTitle?: string;
  ogDescription?: string;
  /** Caminho da imagem OG (1200×630), relativo à raiz do site (sem barra). */
  ogImage?: string;
}

const {
  title,
  description = 'Programa Trainee Redion 2026. Inscrições abertas até 26/08/2026 — o futuro do cuidado começa com você.',
  ogTitle,
  ogDescription,
  ogImage = 'opengraph.jpg',
} = Astro.props;

const tituloSocial = ogTitle ?? title;
const descricaoSocial = ogDescription ?? description;

/** Prefixo do site. Hoje sempre '/': o domínio próprio serve na raiz. */
const BASE = import.meta.env.BASE_URL;

// `site` vem do astro.config.mjs (domínio final desde 03/08/2026)
const SITE_URL = Astro.site ?? new URL('https://traineeredion2026.com.br');
const canonical = new URL(`${BASE}${Astro.url.pathname.replace(BASE, '')}`, SITE_URL).href;
const ogImageUrl = new URL(`${BASE}${ogImage}`, SITE_URL).href;

/**
 * O preview no GitHub Pages não deve ser indexado: o domínio final ainda está
 * pendente e um preview indexado competiria com ele (conteúdo duplicado).
 * Sai automaticamente quando o build deixar de ser o da Action de preview.
 * Lido de process.env (e não de import.meta.env) porque o Vite só expõe
 * variáveis com prefixo PUBLIC_/VITE_; no frontmatter do Astro estático o
 * process.env está disponível em tempo de build.
 */
const naoIndexar = process.env.PREVIEW_NOINDEX === 'true';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Redion',
  url: SITE_URL,
  logo: new URL(`${BASE}images/brand/redion-dark.svg`, SITE_URL).href,
  description:
    'Empresa global líder em soluções de assistência, seguro viagem e benefícios para colaboradores.',
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google Tag Manager — o mais alto possível no <head>, como pede o GTM.
         `is:inline` para o Astro não processar/mover o script. -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-TLVV5RQ');
    </script>
    <!-- End Google Tag Manager -->

    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {naoIndexar && <meta name="robots" content="noindex, nofollow" />}
    <!-- Gerados por scripts/favicon.mjs a partir da asa do logotipo.
         O SVG atende os navegadores atuais; o PNG é fallback e o
         apple-touch-icon vai full-bleed (o iOS aplica a máscara dele). -->
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${BASE}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${BASE}apple-touch-icon.png`} />
    <title>{title}</title>

    <!-- Gabarito é auto-hospedada (ver global.css): zero requisição a terceiros -->
    <link rel="preload" href={gabaritoLatin} as="font" type="font/woff2" crossorigin />
<!-- LCP do hero: a foto de fundo. O preload precisa repetir srcset/sizes do
         <img>, senão o navegador trata como recurso diferente e baixa duas vezes. -->
    <link
      rel="preload"
      as="image"
      href={`${BASE}images/hero/bg-1727.webp`}
      imagesrcset={`${BASE}images/hero/bg-1000.webp 1000w, ${BASE}images/hero/bg-1727.webp 1727w`}
      imagesizes="(max-width: 1023px) 142vw, 1077px"
      fetchpriority="high"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloSocial} />
    <meta property="og:description" content={descricaoSocial} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <!-- Dimensões declaradas: sem elas o WhatsApp/LinkedIn às vezes mostram o
         card pequeno na primeira vez, antes de baixar a imagem. -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Programa Trainee Redion 2026" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloSocial} />
    <meta name="twitter:description" content={descricaoSocial} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Sinaliza JS ativo: os reveals só nascem invisíveis se houver JS. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TLVV5RQ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-medium-red focus:px-4 focus:py-2 focus:text-white"
    >
      Ir para o conteúdo
    </a>
    <slot />
  </body>
</html>
