---
import '../styles/global.css';
// Importada (em vez de referenciada em /public) para que o Vite gere a URL com
// hash e respeitando o `base` — necessário para o preview no GitHub Pages.
import gabaritoLatin from '../assets/fonts/gabarito-latin.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Caminho da imagem OG (1200×630), relativo à raiz do site (sem barra). */
  ogImage?: string;
}

const { title, description = 'Programa Trainee Redion 2026. Inscrições abertas até 26/08/2026 — o futuro do cuidado começa com você.', ogImage = 'og.jpg' } =
  Astro.props;

/** Prefixo do site. Vale '/' local e '/redion-website/' no GitHub Pages. */
const BASE = import.meta.env.BASE_URL;

// `site` vem do astro.config.mjs — TODO: trocar pelo domínio final (ver PROJECT.md)
const SITE_URL = Astro.site ?? new URL('https://exemplo.com.br');
const canonical = new URL(`${BASE}${Astro.url.pathname.replace(BASE, '')}`, SITE_URL).href;
const ogImageUrl = new URL(`${BASE}${ogImage}`, SITE_URL).href;

/**
 * O preview no GitHub Pages não deve ser indexado: o domínio final ainda está
 * pendente e um preview indexado competiria com ele (conteúdo duplicado).
 * Sai automaticamente quando o build deixar de ser o da Action de preview.
 * Lido de process.env (e não de import.meta.env) porque o Vite só expõe
 * variáveis com prefixo PUBLIC_/VITE_; no frontmatter do Astro estático o
 * process.env está disponível em tempo de build.
 */
const naoIndexar = process.env.PREVIEW_NOINDEX === 'true';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Redion',
  url: SITE_URL,
  logo: new URL(`${BASE}images/brand/redion-dark.svg`, SITE_URL).href,
  description:
    'Empresa global líder em soluções de assistência, seguro viagem e benefícios para colaboradores.',
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {naoIndexar && <meta name="robots" content="noindex, nofollow" />}
    <!-- Gerados por scripts/favicon.mjs a partir da asa do logotipo.
         O SVG atende os navegadores atuais; o PNG é fallback e o
         apple-touch-icon vai full-bleed (o iOS aplica a máscara dele). -->
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${BASE}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${BASE}apple-touch-icon.png`} />
    <title>{title}</title>

    <!-- Gabarito é auto-hospedada (ver global.css): zero requisição a terceiros -->
    <link rel="preload" href={gabaritoLatin} as="font" type="font/woff2" crossorigin />
<!-- LCP do hero: a foto de fundo. O preload precisa repetir srcset/sizes do
         <img>, senão o navegador trata como recurso diferente e baixa duas vezes. -->
    <link
      rel="preload"
      as="image"
      href={`${BASE}images/hero/bg-1727.webp`}
      imagesrcset={`${BASE}images/hero/bg-1000.webp 1000w, ${BASE}images/hero/bg-1727.webp 1727w`}
      imagesizes="(max-width: 1023px) 142vw, 1077px"
      fetchpriority="high"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Sinaliza JS ativo: os reveals só nascem invisíveis se houver JS. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-medium-red focus:px-4 focus:py-2 focus:text-white"
    >
      Ir para o conteúdo
    </a>
    <slot />
  </body>
</html>
