---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import SobreSection from '../components/sections/SobreSection.astro';
import ProgramaSection from '../components/sections/ProgramaSection.astro';
import RequisitosSection from '../components/sections/RequisitosSection.astro';
import BeneficiosSection from '../components/sections/BeneficiosSection.astro';
import EtapasSection from '../components/sections/EtapasSection.astro';
import DepoimentosSection from '../components/sections/DepoimentosSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
---

<Base
  title="Programa Trainee Redion 2026 | Inscrições abertas"
  description="Inscrições abertas até 26/08/2026 para o Programa Trainee Redion 2026. Modelo híbrido em Alphaville (SP), trilha de desenvolvimento e carreira em uma empresa global de cuidado."
>
  <Header />

  <main id="main">
    <HeroSection />
    <SobreSection />
    <ProgramaSection />
    <RequisitosSection />
    <BeneficiosSection />
    <EtapasSection />
    <DepoimentosSection />
    <FaqSection />
  </main>

  <Footer />
</Base>
