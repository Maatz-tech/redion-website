---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import SobreSection from '../components/sections/SobreSection.astro';
import ProgramaSection from '../components/sections/ProgramaSection.astro';
import RequisitosSection from '../components/sections/RequisitosSection.astro';
import BeneficiosSection from '../components/sections/BeneficiosSection.astro';
import EtapasSection from '../components/sections/EtapasSection.astro';
import DepoimentosSection from '../components/sections/DepoimentosSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
---

<Base
  {/* Textos de SEO/compartilhamento definidos pelo cliente em 03/08/2026. */}
  title="Programa Trainee Redion 2026 | Inscrições abertas"
  description="Inscreva-se no Programa Trainee Redion 2026. Atuação híbrida em Alphaville e oportunidades para candidatos de todo o Brasil."
  ogTitle="Programa Trainee Redion 2026"
  ogDescription="O futuro do cuidado começa com você. Inscreva-se até 26/08 e desenvolva sua carreira em uma empresa global."
>
  <Header />

  <main id="main">
    <HeroSection />
    <SobreSection />
    <ProgramaSection />
    <RequisitosSection />
    <BeneficiosSection />
    <EtapasSection />
    <DepoimentosSection />
    <FaqSection />
  </main>

  <Footer />
</Base>
